# --- Required on Netlify (Site settings > Environment variables) ---
# MongoDB Atlas connection string (free M0 cluster is fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ghibli_anniversary

# Long random string used to sign the login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Your admin account. Created in MongoDB (password hashed) the first time you log in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pick-a-strong-password
